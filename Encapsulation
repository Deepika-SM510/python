        print("ACCOUNT NUMBER: ",self.__acc_no)
        print("BALANCE: ",self.__bal)
    def updated_balance(self,bal):
        self.bal=bal
        print(f"Balance in your account is: {self.__bal}")    
    
    def deposit(self,Amount):
        self.__bal+=Amount 
        print(self.__bal)
    def withdraw(self,Amount):
        if Amount>self.__bal:
            print("You can't wihdraw amount from your current ssvings")
        else:
            self.__bal-=Amount  
            print(f"{self.__bal}")         

